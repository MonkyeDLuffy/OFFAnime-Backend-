# =============================================================================
# OffAnime.cc backend - environment configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# On Vercel / Cloudflare, set these values as project environment variables
# instead of committing a `.env` file. NEVER commit real secrets.
#
# Values below are safe, non-secret defaults / placeholders only.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development
# Port the traditional Node server (src/server.js) listens on.
# Ignored by serverless platforms, which inject their own port.
PORT=8080
# Bind host for the traditional Node server.
HOST=0.0.0.0

# --- HTTP / CORS -------------------------------------------------------------
# Comma-separated list of allowed origins, or "*" for all.
# Example: https://offanime.cc,https://www.offanime.cc
CORS_ORIGIN=*

# --- API key protection (SECRET - server-side only) ---------------------------
# Required credential for every protected /api/* route (everything except
# GET /api/health). Sent by trusted callers as:
#     Authorization: Bearer <BACKEND_API_SECRET>
#     x-api-key: <BACKEND_API_SECRET>          (accepted fallback)
# Optionally, a RESTRICTED set of approved GET endpoints also accepts
#     ?api_key=<BACKEND_API_SECRET>            (manual browser testing ONLY)
# for direct URL access (see README "API key protection"). Query keys are LESS
# secure: they leak into browser history, shared URLs, and CDN/proxy access
# logs. Never expose this value to the browser/frontend, never log it. Generate
# a long random secret:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In EVERY environment (development included) a missing value FAILS CLOSED:
# protected requests are rejected (500) instead of silently served
# unauthenticated. Local development MUST set a value here too.
BACKEND_API_SECRET=kkjjhhgg

# --- Providers: base URLs (public APIs; not secret) --------------------------
ANILIST_API_URL=https://graphql.anilist.co
JIKAN_API_URL=https://api.jikan.moe/v4
TMDB_API_URL=https://api.themoviedb.org/3
MEGAPLAY_API_URL=https://megaplay.buzz
# AniZip episode metadata (public API; requested directly with the AniList ID).
ANIZIP_API_URL=https://api.ani.zip

# --- Playback proxy (OPTIONAL, not secret) -----------------------------------
# When set, GET /api/stream/resolve/:id returns frontend-safe playback URLs
# through this proxy (/watch/:id?ep=..&lang=..&idType=anilist|mal) instead of
# exposing direct MegaPlay URLs. Leave blank to keep the resolver's internal
# resolution/availability detection only (playback requests then fail with a
# clear typed error rather than exposing a direct MegaPlay URL).
# Example: MEGAPLAY_PROXY_URL=https://megaplayproxy1.vercel.app
MEGAPLAY_PROXY_URL=https://megaplayproxy1.vercel.app

# --- Providers: secrets (SECRET - do not commit real values) -----------------
# TMDB v3 API key or v4 read access token (leave blank until TMDB is wired up).
TMDB_API_KEY=2113b291a9840ee7c5642362b154278e

# --- Persistent cache (L2): Supabase -----------------------------------------
# Leave blank until the Supabase cache layer is used. When both are blank the
# backend runs with L1 (in-memory) caching only.
SUPABASE_URL=
# SECRET - server-side only, never commit a real key. Preferred for the L2
# cache because the service role bypasses RLS. Never expose to the frontend.
# Used ONLY for the cache_entries table - NEVER for user authentication.
SUPABASE_SERVICE_ROLE_KEY=
# The PUBLIC anon/publishable key. Required for user authentication
# (Supabase Auth / GoTrue in src/services/supabase-auth.service.js) and usable
# as the L2 cache fallback. Safe to be public by Supabase design, but keep it
# server-side here anyway.
SUPABASE_ANON_KEY=

# --- User authentication (Supabase Auth - server-side only) -------------------
# Session architecture: token-first (login/signup/refresh return access and
# refresh tokens in the JSON body for Authorization: Bearer use from any
# frontend/domain through the trusted proxy) PLUS optional HttpOnly cookies.
# AUTH_COOKIES_ENABLED=true also sets HttpOnly, Secure (in production),
# SameSite=Lax session cookies (recommended for same-site deployments like
# api.offanime.cc; harmless otherwise - browsers drop cross-site cookies).
AUTH_COOKIES_ENABLED=true
# Max-Age (seconds) of the refresh-token cookie (default 30 days). The access
# cookie always follows the upstream-issued session lifetime.
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
# NOTE: cookie sessions over cross-origin XHR also require CORS_ORIGIN to list
# the frontend origins explicitly (a wildcard cannot send credentials) - see
# CORS_ORIGIN above.

# --- Cache / networking tuning ----------------------------------------------
# Default cache TTL in seconds (used by the cache manager).
CACHE_DEFAULT_TTL_SECONDS=300
# Outbound provider request timeout in milliseconds.
REQUEST_TIMEOUT_MS=10000
# Bounded deadline (ms) for OPTIONAL details enrichment (Jikan/TMDB). Past this
# deadline the enrichment is skipped (like a provider failure) and the response
# returns core AniList data without waiting. 0 disables the deadline.
ENRICHMENT_TIMEOUT_MS=5000

# --- Observability -----------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=info
