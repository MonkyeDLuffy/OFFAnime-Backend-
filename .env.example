# =============================================================================
# OffAnime.cc backend - environment configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# On Vercel / Cloudflare, set these values as project environment variables
# instead of committing a `.env` file. NEVER commit real secrets.
#
# Values below are safe, non-secret defaults / placeholders only.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development
# Port the traditional Node server (src/server.js) listens on.
# Ignored by serverless platforms, which inject their own port.
PORT=8080
# Bind host for the traditional Node server.
HOST=0.0.0.0

# --- HTTP / CORS -------------------------------------------------------------
# Comma-separated list of allowed origins, or "*" for all.
# Example: https://offanime.cc,https://www.offanime.cc
CORS_ORIGIN=*

# --- API key protection (SECRET - server-side only) ---------------------------
# Required credential for every protected /api/* route (everything except
# GET /api/health). Sent by trusted callers as:
#     Authorization: Bearer <BACKEND_API_SECRET>
#     x-api-key: <BACKEND_API_SECRET>          (accepted fallback)
# Optionally, a RESTRICTED set of approved GET endpoints also accepts
#     ?api_key=<BACKEND_API_SECRET>            (manual browser testing ONLY)
# for direct URL access (see README "API key protection"). Query keys are LESS
# secure: they leak into browser history, shared URLs, and CDN/proxy access
# logs. Never expose this value to the browser/frontend, never log it. Generate
# a long random secret:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In EVERY environment (development included) a missing value FAILS CLOSED:
# protected requests are rejected (500) instead of silently served
# unauthenticated. Local development MUST set a value here too.
BACKEND_API_SECRET=kkjjhhgg

# --- Providers: base URLs (public APIs; not secret) --------------------------
ANILIST_API_URL=https://graphql.anilist.co
JIKAN_API_URL=https://api.jikan.moe/v4
TMDB_API_URL=https://api.themoviedb.org/3
MEGAPLAY_API_URL=https://megaplay.buzz
# AniZip episode metadata (public API; requested directly with the AniList ID).
ANIZIP_API_URL=https://api.ani.zip

# --- Playback proxy (OPTIONAL, not secret) -----------------------------------
# When set, GET /api/stream/resolve/:id returns frontend-safe playback URLs
# through this proxy (/watch/:id?ep=..&lang=..&idType=anilist|mal) instead of
# exposing direct MegaPlay URLs. Leave blank to keep the resolver's internal
# resolution/availability detection only (playback requests then fail with a
# clear typed error rather than exposing a direct MegaPlay URL).
# Example: MEGAPLAY_PROXY_URL=https://megaplayproxy1.vercel.app
MEGAPLAY_PROXY_URL=https://megaplayproxy1.vercel.app

# --- Providers: secrets (SECRET - do not commit real values) -----------------
# TMDB v3 API key or v4 read access token (leave blank until TMDB is wired up).
TMDB_API_KEY=2113b291a9840ee7c5642362b154278e

# --- Persistent cache (L2): Supabase -----------------------------------------
# REQUIRED SETUP (see supabase/migrations/20260913000000 + 20261102000000):
#   - apply the cache_entries migration (table + unique (namespace, cache_key)
#     index + RLS),
#   - set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Leaving these blank is supported: the backend runs L1 (in-memory) caching
# only, and an L2 failure NEVER breaks the anime API (a circuit breaker skips
# a broken L2 automatically).
SUPABASE_URL=
# SECRET - server-side only, never commit a real key. REQUIRED for the L2
# cache: the cache_entries table has RLS enabled with no policies, so the
# anon key CANNOT read/write it (using anon would fail every operation with
# "Supabase cache read/write failed"). Never expose to the frontend.
# Used ONLY for the cache_entries table and the auth limiter tables - NEVER
# for user data queries (those forward the user's own token with the anon key).
SUPABASE_SERVICE_ROLE_KEY=
# The PUBLIC anon/publishable key. Required for user authentication
# (Supabase Auth / GoTrue in src/services/supabase-auth.service.js) and for
# user-owned data through RLS (watchlist). Safe to be public by Supabase
# design, but keep it server-side here anyway.
SUPABASE_ANON_KEY=

# --- L2 (Supabase) cache circuit breaker --------------------------------------
# After this many CONSECUTIVE L2 failures the backend skips Supabase entirely
# (clean L1-only fallback, provider responses unaffected) for a growing
# cooldown (30s doubling up to 5min) so a broken/misconfigured L2 is not
# hammered on every request. Successful operations close the breaker.
CACHE_L2_FAILURE_THRESHOLD=5
CACHE_L2_BREAKER_OPEN_MS=30000
CACHE_L2_BREAKER_MAX_OPEN_MS=300000

# --- User authentication (Supabase Auth - server-side only) -------------------
# Session architecture: token-first (login/signup/refresh return access and
# refresh tokens in the JSON body for Authorization: Bearer use from any
# frontend/domain through the trusted proxy) PLUS optional HttpOnly cookies.
AUTH_COOKIES_ENABLED=true
# Max-Age (seconds) of the refresh-token cookie (default 30 days). The access
# cookie always follows the upstream-issued session lifetime.
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=2592000
# NOTE: cookie sessions over cross-origin XHR also require CORS_ORIGIN to list
# the frontend origins explicitly (a wildcard cannot send credentials) - see
# CORS_ORIGIN above.
#
# EMAIL CONFIRMATION: OFFANIME does NOT use email verification. In the
# Supabase Dashboard -> Authentication -> Sign In / Providers -> Email, turn
# "Confirm email" OFF. Signup then auto-confirms accounts, returns a session
# immediately, and sends NO verification email. Password-reset emails keep
# working. POST /api/auth/resend stays RESERVED (501) until a future email
# feature activates it.
#
# --- Login attempt limiting + signup anti-abuse (DB-backed) -------------------
# Failed logins are tracked per NORMALIZED ACCOUNT (hashed email) in Supabase
# (auth_attempt_limits table + atomic RPC), shared across ALL serverless
# instances. Defaults implement: block after 5 failed attempts within
# 15 minutes, for 15 minutes; a successful login clears the counter. A
# separate per-IP failure limit throttles credential-stuffing floods.
# When the tracker store is unavailable the limiter FAILS OPEN (login
# availability first; Supabase Auth's own limits still apply).
AUTH_ATTEMPT_LIMITS_ENABLED=true
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_LOGIN_IP_MAX_FAILURES=20
# Signup attempts per source IP (registers BEFORE the upstream GoTrue call so
# floods never burn Supabase Auth quota). Successful signups are remembered
# briefly (hashed email) so duplicate POSTs skip the upstream call.
AUTH_SIGNUP_IP_MAX_ATTEMPTS=10
AUTH_SIGNUP_IP_WINDOW_SECONDS=3600
AUTH_SIGNUP_IP_LOCK_SECONDS=900
AUTH_SIGNUP_DEDUPE_TTL_SECONDS=600
#
# --- OPTIONAL: forward the END-USER IP to Supabase Auth ------------------------
# Without this, GoTrue's per-IP rate limits apply to THIS BACKEND'S shared
# egress IP: traffic from unrelated users can exhaust the quota and 429
# everyone (the production "POST /api/auth/signup -> 429" cause). With it,
# GoTrue limits apply per END USER.
# Requirements: (1) Dashboard -> Authentication -> Rate Limits -> enable
# "IP address forwarding"; (2) use a NEW SECRET key (sb_secret_...) below -
# legacy anon/service_role keys are NOT accepted for forwarding.
AUTH_GOTRUE_IP_FORWARDING=false
AUTH_GOTRUE_SECRET_KEY=

# --- Cache / networking tuning ----------------------------------------------
# Default cache TTL in seconds (used by the cache manager).
CACHE_DEFAULT_TTL_SECONDS=300
# Outbound provider request timeout in milliseconds.
REQUEST_TIMEOUT_MS=10000
# Bounded deadline (ms) for OPTIONAL details enrichment (Jikan/TMDB). Past this
# deadline the enrichment is skipped (like a provider failure) and the response
# returns core AniList data without waiting. 0 disables the deadline.
ENRICHMENT_TIMEOUT_MS=5000

# --- Observability -----------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=info
